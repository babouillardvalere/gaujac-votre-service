{
  "name": "InterventionClient",
  "type": "object",
  "properties": {
    "type_intervention": {
      "type": "string",
      "enum": [
        "INVENTAIRE_ARRIVEE",
        "INVENTAIRE_DEPART",
        "SIGNALEMENT_SEJOUR"
      ],
      "description": "Type d'intervention client"
    },
    "type_hebergement": {
      "type": "string",
      "description": "Type d'h\u00e9bergement (ex: MH Premium 2ch)"
    },
    "numero_hebergement": {
      "type": "string",
      "description": "Num\u00e9ro de l'h\u00e9bergement"
    },
    "client_nom": {
      "type": "string",
      "description": "Nom du client"
    },
    "client_prenom": {
      "type": "string",
      "description": "Pr\u00e9nom du client"
    },
    "date_arrivee": {
      "type": "string",
      "format": "date",
      "description": "Date d'arriv\u00e9e"
    },
    "date_depart": {
      "type": "string",
      "format": "date",
      "description": "Date de d\u00e9part"
    },
    "service": {
      "type": "string",
      "enum": [
        "TECHNIQUE",
        "MENAGE",
        "RECEPTION"
      ],
      "description": "Service assign\u00e9"
    },
    "priorite": {
      "type": "string",
      "enum": [
        "NORMALE",
        "URGENTE"
      ],
      "default": "NORMALE",
      "description": "Priorit\u00e9"
    },
    "description": {
      "type": "string",
      "description": "Description d\u00e9taill\u00e9e"
    },
    "taches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number"
          },
          "texte": {
            "type": "string"
          },
          "objet_id": {
            "type": "string"
          },
          "faite": {
            "type": "boolean",
            "default": false
          },
          "justification": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "commande_requise": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Liste des t\u00e2ches num\u00e9rot\u00e9es"
    },
    "statut": {
      "type": "string",
      "enum": [
        "A_FAIRE",
        "EN_COURS",
        "EN_ATTENTE",
        "TERMINEE"
      ],
      "default": "A_FAIRE",
      "description": "Statut de l'intervention"
    },
    "pris_en_charge_par": {
      "type": "string",
      "description": "Nom de l'agent"
    },
    "date_prise_en_charge": {
      "type": "string",
      "format": "date-time"
    },
    "temps_ecoule_minutes": {
      "type": "number",
      "default": 0
    },
    "date_terminee": {
      "type": "string",
      "format": "date-time"
    },
    "autorisation_acces": {
      "type": "string",
      "enum": [
        "oui",
        "non"
      ],
      "description": "Autorisation d'acc\u00e8s h\u00e9bergement"
    },
    "plages_horaires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plages horaires si acc\u00e8s refus\u00e9"
    },
    "fiche_arrivee_id": {
      "type": "string",
      "description": "ID de la fiche d'arriv\u00e9e"
    },
    "fiche_depart_id": {
      "type": "string",
      "description": "ID de la fiche de d\u00e9part"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL du PDF r\u00e9capitulatif"
    }
  },
  "required": [
    "type_intervention",
    "type_hebergement",
    "numero_hebergement",
    "service",
    "client_nom",
    "client_prenom",
    "taches"
  ]
}
{
  "name": "InterventionEvent",
  "type": "object",
  "properties": {
    "intervention_id": {
      "type": "string",
      "description": "ID de l'intervention parente"
    },
    "service": {
      "type": "string",
      "enum": [
        "MENAGE",
        "TECHNIQUE"
      ],
      "description": "Service concern\u00e9"
    },
    "type": {
      "type": "string",
      "enum": [
        "DEMANDE_RECUE",
        "PRISE_EN_CHARGE",
        "ARRIVEE_SUR_SITE",
        "EN_COURS",
        "MISE_EN_ATTENTE",
        "REPRISE",
        "TERMINEE",
        "DEPART_SERVICE"
      ],
      "description": "Type d'\u00e9v\u00e9nement timeline"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "Horodatage de l'\u00e9v\u00e9nement"
    },
    "auteur": {
      "type": "string",
      "description": "Auteur de l'action (Syst\u00e8me ou nom collaborateur)"
    },
    "message": {
      "type": "string",
      "description": "Message descriptif"
    },
    "attente_raison": {
      "type": "string",
      "enum": [
        "attente_materiel",
        "attente_fournisseur",
        "client_absent",
        "piece_specifique",
        "second_technicien",
        "autre"
      ],
      "description": "Raison de l'attente si applicable"
    },
    "attente_motif": {
      "type": "string",
      "description": "Motif d\u00e9taill\u00e9 de l'attente"
    },
    "attente_delai": {
      "type": "string",
      "description": "D\u00e9lai estim\u00e9 pour r\u00e9solution"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la photo associ\u00e9e"
    }
  },
  "required": [
    "intervention_id",
    "service",
    "type",
    "at",
    "auteur",
    "message"
  ]
}
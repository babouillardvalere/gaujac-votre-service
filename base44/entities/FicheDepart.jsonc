{
  "name": "FicheDepart",
  "type": "object",
  "properties": {
    "client_nom": {
      "type": "string",
      "description": "Nom du client"
    },
    "client_prenom": {
      "type": "string",
      "description": "Pr\u00e9nom du client"
    },
    "date_arrivee": {
      "type": "string",
      "format": "date",
      "description": "Date d'arriv\u00e9e"
    },
    "date_depart": {
      "type": "string",
      "format": "date",
      "description": "Date de d\u00e9part"
    },
    "numero_logement": {
      "type": "string",
      "description": "Num\u00e9ro du locatif"
    },
    "categorie_logement": {
      "type": "string",
      "description": "Cat\u00e9gorie du logement"
    },
    "type_logement": {
      "type": "string",
      "enum": [
        "emplacement",
        "mobilhome"
      ],
      "description": "Type de logement"
    },
    "inventaire_objets_etat": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u00c9tat des objets au d\u00e9part"
    },
    "photos_depart": {
      "type": "object",
      "description": "Photos au d\u00e9part"
    },
    "evaluation_proprete": {
      "type": "string",
      "enum": [
        "pas_satisfaisant",
        "correct",
        "tres_propre"
      ],
      "description": "\u00c9valuation de la propret\u00e9 au d\u00e9part"
    },
    "remarques_staff": {
      "type": "string",
      "description": "Remarques du staff"
    },
    "signature_url": {
      "type": "string",
      "description": "URL de la signature"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL du PDF g\u00e9n\u00e9r\u00e9"
    },
    "pdf_status": {
      "type": "string",
      "enum": [
        "en_attente",
        "en_cours",
        "termine",
        "erreur"
      ],
      "default": "en_attente",
      "description": "Statut de g\u00e9n\u00e9ration du PDF"
    },
    "pdf_status_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Date derni\u00e8re MAJ statut PDF"
    },
    "pdf_error": {
      "type": "string",
      "description": "Message d'erreur si \u00e9chec g\u00e9n\u00e9ration PDF"
    },
    "email_envoye": {
      "type": "boolean",
      "default": false,
      "description": "Email envoy\u00e9"
    },
    "date_validation": {
      "type": "string",
      "format": "date-time",
      "description": "Date de validation"
    },
    "degats_signales": {
      "type": "boolean",
      "default": false,
      "description": "D\u00e9g\u00e2ts signal\u00e9s"
    }
  },
  "required": [
    "client_nom",
    "client_prenom",
    "date_arrivee",
    "date_depart",
    "numero_logement"
  ]
}